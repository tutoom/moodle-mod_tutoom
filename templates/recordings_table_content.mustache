{{!
    @template mod_tutoom/recordings_table_content

    This template renders the recordings table content with improved accessibility.

    Example context (json):
    {
        "recordings": [
            {
                "roomid": "12345",
                "thumbnail": "https://example.com/thumb.jpg",
                "duration": "1h 30min",
                "date": "Jan 15, 2025",
                "time": "10:00 AM",
                "renderRowSeparator": true
            }
        ]
    }
}}

{{#recordings}}
    <div class="tutoom-recordings-row" role="listitem">
        <div class="tutoom-recordings-thumbnail">
            <div class="tutoom-recordings-thumbnail-content">
                <img
                    src="{{thumbnail}}"
                    alt="{{#str}} recording_preview, mod_tutoom {{/str}} - {{date}} {{time}}"
                >
                <div class="mask" aria-hidden="true">
                    <span>
                        <img src='pix/icon-play.svg' alt="">
                    </span>
                </div>
                <button
                    class="thumbnail"
                    data-roomid="{{roomid}}"
                    aria-label="{{#str}} view_icon_play, mod_tutoom {{/str}} - {{date}} {{time}}"
                    title="{{#str}} view_icon_play, mod_tutoom {{/str}}"
                ></button>
            </div>
        </div>
        <h5>{{duration}}</h5>
        <h5>{{date}}</h5>
        <h5>{{time}}</h5>
    </div>
    {{#renderRowSeparator}}
        <div class="tutoom-row-separator" role="separator" aria-hidden="true"></div>
    {{/renderRowSeparator}}
{{/recordings}}
