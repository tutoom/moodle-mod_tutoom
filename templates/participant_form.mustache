{{!
    @template mod_tutoom/participant_form

    This template renders the participant management form

    Example context (json):
    {
        "selectionType": {},
        "selectionParticipant": {},
        "action": {}
    }
}}
<div class="participant-form">
    <div class="d-flex flex-wrap align-items-center mb-3">
        {{#selectionType}}
            <div class="me-2">
                {{> mod_tutoom/participant_single_select}}
            </div>
        {{/selectionType}}
        {{#selectionParticipant}}
            <div class="me-2">
                {{> mod_tutoom/participant_single_select}}
            </div>
        {{/selectionParticipant}}
        {{#action}}
            <div>
                <button type="submit" class="btn {{#primary}}btn-primary{{/primary}}{{^primary}}btn-secondary{{/primary}}"
                id="{{id}}"
                title={{#quote}}{{tooltip}}{{/quote}}
                {{#disabled}}disabled{{/disabled}}
                {{#attributes}} {{name}}={{#quote}}{{value}}{{/quote}} {{/attributes}}>{{label}}</button>
            </div>
        {{/action}}
    </div>
    <table id="participant_list_table" class="generaltable">
        <tbody></tbody>
    </table>
</div>
