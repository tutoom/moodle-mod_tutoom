{{!
    @template mod_tutoom/status_indicator

    Reusable status indicator with icon and text

    Example context (json):
    {
        "icon": "icon-clock.svg",
        "text": "Session started at 10:00 AM",
        "iconalt": "Clock icon"
    }
}}
<div class="tutoom-status-indicator">
    <img src="{{#pix}}{{icon}}, mod_tutoom{{/pix}}" alt="{{iconalt}}" class="tutoom-status-icon">
    <span class="tutoom-status-text">{{{text}}}</span>
</div>
